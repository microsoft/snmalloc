module(name = "snmalloc")

bazel_dep(name = "rules_cc", version = "0.2.19")
# Test-only deps. Marked dev so downstream consumers (e.g. workspaces that
# depend on @snmalloc//snmalloc-rs:snmalloc_rs) don't transitively pull
# fuzztest/googletest + the older rules_go they drag in.
bazel_dep(name = "fuzztest", version = "20260219.0", dev_dependency = True)
bazel_dep(name = "googletest", version = "1.17.0.bcr.2", dev_dependency = True)

# -----------------------------------------------------------------------------
# Rust support (snmalloc-rs / snmalloc-sys).
#
# rules_rust gives us `rust_library` / `rust_test`. The snmalloc-sys crate's
# hand-written `extern "C"` decls in `snmalloc-rs/snmalloc-sys/src/lib.rs`
# are consumed verbatim; the C archive comes from the root `BUILD.bazel`
# Bazel-native `cc_library` shim targets. No bindgen step is involved — the
# FFI surface is small and stable, and skipping bindgen removes the libclang /
# LLVM source-tree transitive dependency.
# -----------------------------------------------------------------------------
bazel_dep(name = "rules_rust", version = "0.71.3")

# Rust toolchain is registered for snmalloc's own dev/CI loop only.
# Downstream consumers register their own toolchain; pulling this one in
# transitively would conflict with their pin.
rust = use_extension(
    "@rules_rust//rust:extensions.bzl",
    "rust",
    dev_dependency = True,
)
rust.toolchain(
    edition = "2021",
    versions = ["1.90.0"],
)
use_repo(rust, "rust_toolchains")

# crate_universe entries for snmalloc-rs optional dependencies. Currently:
#   * flate2    -- pulled by the `profiling` Cargo feature via `dep:flate2`
#                  for `HeapProfile::write_pprof_gz`.
#   * backtrace -- pulled by the `symbolicate` Cargo feature via
#                  `dep:backtrace` to resolve raw frame addresses captured
#                  by the profiler into function/file/line at dump time.
#                  Required for the `:snmalloc_rs_profiling_symbolicated`
#                  target.
#
# dev_dependency = True: this crate_universe extension is for snmalloc's own
# dev/CI loop (tests under snmalloc-rs/BUILD.bazel) only. bzlmod skips
# dev_dependency extensions entirely when this module is a non-root
# dependency, so a downstream consumer's own `bazel mod deps`/lockfile
# resolution never evaluates `crate.from_specs()` here and never needs a
# lockfile for it — the actual fix for rules_rust >=0.71.1's "is in a
# non-root module but has no lockfile" requirement. The cost: downstream
# consumers cannot resolve `@crates`/`@snmalloc_crates` and therefore cannot
# build `:snmalloc_rs_profiling` / `:snmalloc_rs_profiling_symbolicated`
# directly (`No repository visible as '@crates' from repository
# '@@snmalloc+'`) -- use `:snmalloc_rs_profile_compat` instead (see
# snmalloc-rs/BUILD.bazel), which gets the SNMALLOC_PROFILE=ON C archive
# without the flate2/backtrace Rust-side deps.
#
# The materialised repo is still named `snmalloc_crates` (not the default
# `crates`) to avoid colliding with downstream consumers' own `crate_universe`
# usage: default-named (`crates`) non-dev declarations from multiple modules
# merge into one global crate universe, and bzlmod refuses with `Defined two
# crate universes with the same name in different MODULE.bazel files
# (crates)`. `use_repo(crate, crates = "snmalloc_crates")` aliases the
# renamed repo back to `@crates` inside THIS module's own namespace only, so
# `snmalloc-rs/BUILD.bazel`'s `@crates//:flate2` references keep working when
# snmalloc itself is the root module (its own tests/CI).
crate = use_extension(
    "@rules_rust//crate_universe:extensions.bzl",
    "crate",
    dev_dependency = True,
)
crate.spec(
    package = "flate2",
    version = "1",
)
crate.spec(
    package = "backtrace",
    version = "0.3",
)
crate.from_specs(name = "snmalloc_crates")
use_repo(crate, crates = "snmalloc_crates")
